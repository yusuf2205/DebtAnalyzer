# Скопируйте в .env (файл .env в Git не попадает). Секреты генерируйте сами: openssl rand -base64 32

POSTGRES_PASSWORD=
# Начальный SUPER_ADMIN создаётся при первом запуске, если пользователей нет. Пароль >= 12 символов, буквы и цифры (проверяет preflight.sh; пользовательские пароли — от 4 символов); смена обязательна при первом входе.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Токен туннеля из Cloudflare Zero Trust -> Networks -> Tunnels (Public hostname -> http://web:3000)
CLOUDFLARE_TUNNEL_TOKEN=

# Куда складывать резервные копии: АБСОЛЮТНЫЙ путь на другом томе/диске, чем база данных (например /volume2/backups/procurement),
# и сколько дней хранить (всегда остаются не менее 7 последних). Копируйте этот каталог ещё и за пределы NAS.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30

# --- Google Sheets ---
# Публичные таблицы («Все, у кого есть ссылка») работают БЕЗ этих настроек.
# Они нужны только для закрытых таблиц (вход через Google, права только на чтение таблиц).
# Google Cloud Console -> APIs & Services: включить Google Sheets API; Credentials -> OAuth client ID (Web application);
# Authorized redirect URI = GOOGLE_REDIRECT_URI. Если приложение в режиме Testing — добавьте свой аккаунт в Test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ВАШ-ДОМЕН/api/google/oauth/callback
# Ключ шифрования Google-токенов в БД (>= 32 символов): openssl rand -base64 48. Потеряете — придётся подключить аккаунт заново.
TOKEN_ENCRYPTION_KEY=

# --- Копия вне NAS (rclone). Выключено, пока не заданы профиль и адрес. См. docs/RUNBOOK.md, deploy/rclone.conf.example ---
# COMPOSE_PROFILES=offsite
# OFFSITE_REMOTE=secret:procurement
# OFFSITE_KEEP_DAYS=90

# --- Уведомления (необязательно). Получатели, час и состав сводки — в приложении: «Уведомления» ---
# TELEGRAM_BOT_TOKEN=            # токен бота от @BotFather; chat id узнаёт бот @userinfobot или getUpdates
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Procurement Finance <noreply@example.com>"
# SMTP_SECURE=false
# APP_TIMEZONE=Asia/Tashkent
# APP_BASE_URL=https://finance.toppro.uz

# Имя проекта Compose: определяет имена томов (procurement_pgdata). Не меняйте после первого запуска.
COMPOSE_PROJECT_NAME=procurement
