# API и worker используют один образ (разные команды запуска). Контекст сборки — корень репозитория.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY e2e/package.json e2e/
# Зависимости ставятся только для нужных пакетов (без браузерных E2E-инструментов).
RUN npm ci --include-workspace-root -w @pf/shared -w @pf/api
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm run build -w @pf/shared && npm run build -w @pf/api
RUN npm prune --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates curl && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /data/uploads && chown -R node:node /data
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/packages/shared packages/shared
COPY --from=build /app/apps/api apps/api
WORKDIR /app/apps/api
USER node
EXPOSE 4000
# Миграции применяются прямым вызовом CLI из node_modules (без npx: файловая система контейнера может быть только для чтения).
CMD ["sh", "-c", "node ../../node_modules/prisma/build/index.js migrate deploy && node dist/main.js"]
